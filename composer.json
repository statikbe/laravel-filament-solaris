{
    "name": "statikbe/laravel-filament-solaris",
    "description": "AI actions for Filament v4 & v5 — auto-detect form fields, compose prompts, and write structured AI responses back. Powered by laravel-ai.",
    "keywords": [
        "statikbe",
        "laravel",
        "laravel-filament-solaris"
    ],
    "homepage": "https://github.com/statikbe/laravel-filament-solaris",
    "license": "MIT",
    "authors": [
        {
            "name": "Sten Govaerts",
            "email": "sten.govaerts@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.2||^5.0",
        "laravel/ai": "^0.4",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0||^12.0",
        "ext-intl": "*"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Statikbe\\FilamentSolaris\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Statikbe\\FilamentSolaris\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Statikbe\\FilamentSolaris\\FilamentSolarisServiceProvider"
            ],
            "aliases": {
                "FilamentSolaris": "Statikbe\\FilamentSolaris\\Facades\\FilamentSolaris"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
