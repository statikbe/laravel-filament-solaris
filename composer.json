{
    "name": "statikbe/laravel-filament-solaris",
    "description": "AI actions for Filament v4 & v5 — auto-detect form fields, compose prompts, and write structured AI responses back. Powered by laravel-ai.",
    "keywords": [
        "laravel",
        "filament",
        "ai",
        "llm",
        "agent",
        "prompt",
        "openai",
        "anthropic",
        "gemini",
        "conversation",
        "chat",
        "transcription",
        "dictation",
        "whisper",
        "image-generation",
        "dall-e",
        "gpt-image-1",
        "statikbe",
        "laravel-filament-solaris",
        "laravel-ai"
    ],
    "homepage": "https://github.com/statikbe/laravel-filament-solaris",
    "license": "MIT",
    "authors": [
        {
            "name": "Sten Govaerts",
            "email": "sten.govaerts@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.2||^5.0",
        "laravel/ai": "^0.8",
        "spatie/laravel-package-tools": "^1.93",
        "illuminate/contracts": "^12.41||^13.0"
    },
    "suggest": {
        "ext-intl": "Required for human-readable locale display names in TranslationPreset. Without it, locale codes (e.g. 'nl') are shown instead of names (e.g. 'Dutch') unless a translation entry is published."
    },
    "require-dev": {
        "filament/spatie-laravel-media-library-plugin": "^4.2||^5.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "spatie/laravel-medialibrary": "^11.0||^12.0"
    },
    "autoload": {
        "psr-4": {
            "Statikbe\\FilamentSolaris\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Statikbe\\FilamentSolaris\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Statikbe\\FilamentSolaris\\FilamentSolarisServiceProvider"
            ],
            "aliases": {
                "FilamentSolaris": "Statikbe\\FilamentSolaris\\Facades\\FilamentSolaris"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
